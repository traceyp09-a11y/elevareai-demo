{
  "name": "elevareiq-mvp-backend",
  "version": "1.0.0",
  "description": "ElevareIQ-MVP HR Analytics Platform - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "init-db": "ts-node src/data/initDatabase.ts",
    "seed-data": "ts-node src/data/seedData.ts",
    "seed-hse": "ts-node src/data/seedDataHSE.ts",
    "seed-ops": "ts-node src/data/seedDataOps.ts",
    "seed-qc": "ts-node src/data/seedDataQC.ts",
    "seed-supplychain": "ts-node src/data/seedDataSupplyChain.ts",
    "init:finance": "ts-node src/scripts/initFinance.ts",
    "init:administration": "ts-node src/scripts/initAdministration.ts",
    "init:sales": "ts-node src/scripts/initSales.ts",
    "init:customer-success": "ts-node src/scripts/initCustomerSuccess.ts",
    "init:marketing": "ts-node src/scripts/initMarketing.ts"
  },
  "keywords": [
    "hr",
    "analytics",
    "kpi",
    "dashboard"
  ],
  "author": "ElevareIQ",
  "license": "PROPRIETARY",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
