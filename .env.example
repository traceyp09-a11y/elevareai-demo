# Database
DATABASE_URL=postgresql://elevare:elevare_dev_password@localhost:5432/elevare_ai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-secret-change-in-production

# Okta OIDC (Optional - Configure for SSO)
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001

# AWS (Optional - For S3, Secrets Manager, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Snowflake (Optional - For read-only connector)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_SECRET_ARN=

# Jira (Optional - For project sync)
JIRA_CLOUD_ID=
JIRA_ACCESS_TOKEN=
