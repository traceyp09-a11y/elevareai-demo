# ElevareAI Frontend Environment Configuration
# Copy this file to .env.local and update the values

# API Configuration
# The backend API URL - defaults to relative /api/ for Docker environments
# VITE_API_URL=/api

# Development Settings
# NODE_ENV=development

# Webpack Backend URL (used in webpack.config.js proxy)
# WEBPACK_BACKEND_URL=http://backend:3001

# Production Settings
# NODE_ENV=production
# VITE_API_URL=https://api.yourdomain.com
